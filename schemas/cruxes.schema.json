{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/cruxes.schema.json",
  "title": "cruxes.json",
  "type": "object",
  "required": ["cruxes"],
  "properties": {
    "cruxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "sides"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "options": {"type": "array", "items": {"type": "string"}},
          "sides": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["members"],
              "properties": {
                "label": {"type": "string"},
                "position": {"type": "string"},
                "members": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": true
            }
          },
          "evidence_needed": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {"type": "string"},
          "asked_by": {"type": "array", "items": {"type": "string"}},
          "why": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
